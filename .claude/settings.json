{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.gitleaks.toml)",
      "Edit(.gitleaksignore)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-guard.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
